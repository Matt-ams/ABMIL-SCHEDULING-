# Neon: PostgreSQL pooled connection URL, use sslmode=require.
# NEVER put this in NEXT_PUBLIC_* or commit .env.local.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Generate two DIFFERENT random values, each at least 32 characters:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=""
# Temporary ONLY during the first installation, then remove from host.
APP_SETUP_KEY=""
