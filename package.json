{
  "name": "abmil-pose-workforce",
  "version": "1.0.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "test:logic": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run test:logic && npm run build && npm run build:vinext",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.3.4",
    "lucide-react": "^0.469.0",
    "next": "16.4.6",
    "pg": "^8.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@netlify/plugin-nextjs": "^5.16.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.32",
    "typescript": "^5.7.0",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "description": "ABMIL Pose — outil de planning BTP et pointages pour 5 à 10 salariés",
  "overrides": {
    "fflate": "0.7.5"
  }
}
